{:paths ["src"]

 ;; ZERO `:local/root`. Every dependency below is a git coordinate, so this
 ;; repo resolves from a clone with no sibling checkouts on disk — which is
 ;; also the only way a murakumo fleet gate can build it, since the fleet
 ;; ships one repo's tree and no siblings (AGENTS.md, fleet-ci section).
 ;; The suite in this repo is run from a directory with no siblings before
 ;; every release; that is the measurement, not the intention.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       ;; The itonami actor pattern's governor layer, written once. The
        ;; verdict map is NOT hand-rolled here — `gov/verdict` assembles it,
        ;; and `gov/conformance-failures` is asserted over every verdict this
        ;; actor can emit (see test/shiharai/conformance_test.kotoba).
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.governor"}

        ;; What a tax record must carry, by jurisdiction. Answers in THREE
        ;; values (`:none` / `:not-declared` / `:checked`), and this actor
        ;; keeps all three rather than collapsing them to a boolean.
        io.github.kotoba-lang/taxlaw
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.taxlaw"}

        ;; IBAN (ISO 13616) mod-97 identification and double-entry
        ;; balanced-posting validation. The governor redrafts the posting a
        ;; payment would produce from the store's own records and validates
        ;; it with `bank/balanced?` — it does not trust the advisor's
        ;; arithmetic and it does not reimplement the checksum.
        ;;
        ;; `kotoba.banking.api` (Open Banking payment initiation) is
        ;; deliberately NOT used. See README, "The ceiling".
        io.github.kotoba-lang/banking
        {:git/url "https://github.com/kotoba-lang/banking.git"
         :git/sha "b8750ad17d16c012c7de62d4bf785973464495cc"}

        ;; StateGraph + checkpointing, so `:release-payment` interrupts
        ;; before a human resumes the thread.
        io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langgraph"}

        ;; The shared `langchain.db` store seam (EDN-blob codec, identity
        ;; schema, seq-keyed event streams) behind `DatomicStore`
        ;; — ADR-2607141600. Its own `deps.edn` has ZERO `:local/root`
        ;; (checked by READING it as EDN, not by grepping it: that file
        ;; discusses a `:local/root` it no longer has, so a grep answers
        ;; yes and the reader answers no), and its one transitive dep,
        ;; io.github.com-junkawasaki/langchain-clj, is a git coordinate
        ;; too. The whole chain therefore resolves in a bare clone.
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langchainStore"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
