 ;; ---------------------------------------------------------------------
 ;; 仕訳 — the hand-off to the ledger. Every mutation here is a way a
 ;; payment that really happened stops becoming a journal entry, or becomes
 ;; the wrong one. None of them makes anything go red on its own: that is
 ;; the whole reason the seam needed measuring.
 ;; ---------------------------------------------------------------------

 {:id :shiwake-unauthorised-is-its-own-status
  :invariant "a payment that was not authorised is a named refusal"
  :file "src/shiharai/shiwake.cljc"
  :find "      (not= :commit disposition)"
  :replace "      (= :never-a-disposition disposition)"}

 ;; The first version of this one was a SURVIVOR, and the harness was right:
 ;; it widened a check that `(= :scheduled status)` already shadowed, so
 ;; nothing was broken and nothing should have gone red. The code was
 ;; restructured to test `postable-statuses` FIRST, which is what makes the
 ;; set the only thing deciding what posts — and therefore the only thing
 ;; that can be widened wrongly.
 {:id :shiwake-only-an-authorised-payment-posts
  :invariant "a scheduled payment is a commitment, not a settlement"
  :file "src/shiharai/shiwake.cljc"
  :find "  #{:authorised})"
  :replace "  #{:authorised :scheduled})"}

 {:id :shiwake-scheduled-has-its-own-name
  :invariant "`wait for approval` is a different instruction from `look at this`"
  :file "src/shiharai/shiwake.cljc"
  :find "      (= :scheduled status)"
  :replace "      (= :scheduled :never-this-status)"}

 {:id :shiwake-unknown-status-is-not-approval-pending
  :invariant "an unreadable status is not called `awaiting approval`"
  :file "src/shiharai/shiwake.cljc"
  :find "      {:shiwake/status :unknown-payment-status\n"
  :replace "      {:shiwake/status :not-released\n"}

 {:id :shiwake-no-suspense-account
  :invariant "an unmapped supplier does not fall back to a suspense account"
  :file "src/shiharai/shiwake.cljc"
  :find "            liability (get-in mapping [:suppliers supplier-id])"
  :replace "            liability (or (get-in mapping [:suppliers supplier-id]) \"仮払金\")"}

 {:id :shiwake-half-a-mapping-is-no-mapping
  :invariant "an entry missing one line balances by having lost it"
  :file "src/shiharai/shiwake.cljc"
  :find "          (or (absent? liability) (absent? cash))"
  :replace "          (and (absent? liability) (absent? cash))"}

 {:id :shiwake-amount-is-a-positive-integer-of-minor-units
  :invariant "the ledger's parser takes any number?, so this one does not"
  :file "src/shiharai/shiwake.cljc"
  :find "  (and (int? x) (pos? x)))"
  :replace "  (number? x))"}

 {:id :shiwake-currency-must-be-declared
  :invariant "an amount with no unit is not an amount"
  :file "src/shiharai/shiwake.cljc"
  :find "              (absent? currency)"
  :replace "              false"}

 {:id :shiwake-a-document-must-be-cited
  :invariant "an entry citing nothing is a transaction nobody can trace"
  :file "src/shiharai/shiwake.cljc"
  :find "              (absent? payable))"
  :replace "              (false? payable))"}

 {:id :shiwake-the-payment-discharges-a-liability
  :invariant "Dr the liability, Cr the cash — not two credits, not an expense"
  :file "src/shiharai/shiwake.cljc"
  :find "            :lines [{:side :dr :account liability"
  :replace "            :lines [{:side :cr :account liability"}

 {:id :shiwake-every-line-carries-its-currency
