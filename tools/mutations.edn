 ;; Found by reading governor.cljc for branches with no mutation against them,
 ;; not by adding weight around rules already covered.

 {:id :ap-account-ignored
  :invariant "a payable's own 買掛金 control account is the one debited"
  :file "src/shiharai/governor.cljc"
