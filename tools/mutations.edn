 {:id :handoff-fact-names-the-payment
  :invariant "the payment id the entry body cannot carry is kept here"
  :file "src/shiharai/handoff.cljc"
  :find "   :handoff/payment-id (:shiwake/payment-id converted)"
  :replace "   :handoff/payment-id (:shiwake/no-such-key converted)"}

 {:id :handoff-fact-names-the-supplier
  :invariant "the supplier the actor's own ledger stamps is stamped here too"
  :file "src/shiharai/handoff.cljc"
  :find "   :handoff/supplier-id (get-in converted [:shiwake/record :supplier-id])"
  :replace "   :handoff/supplier-id (get-in converted [:shiwake/record :not-a-key])"}

 {:id :handoff-posting-key-always-present
  :invariant "the ledger's posting id is reported even when there is none"
  :file "src/shiharai/handoff.cljc"
  :find ":handoff/posting (when (map? body) (:posting body))}"
  :replace ":handoff/no-posting (when (map? body) (:posting body))}"}

 {:id :handoff-unsubmitted-is-not-scored
  :invariant "a reply is never attributed to an entry nobody sent"
  :file "src/shiharai/handoff.cljc"
  :find "      (not= :ok (:shiwake/status converted))\n      (not-submitted converted response"
  :replace "      (and false (:shiwake/status converted))\n      (not-submitted converted response"}

 {:id :handoff-unsubmitted-is-not-scored-in-a-batch
  :invariant "a batch result is never attributed to an entry nobody sent"
  :file "src/shiharai/handoff.cljc"
  :find "      (or (not= :ok (:shiwake/status converted)) (absent? payable))"
  :replace "      (or (and false (:shiwake/status converted)) (absent? payable))"}

 {:id :handoff-length-mismatch-refused
  :invariant "a batch whose counts differ is refused, not zipped"
  :file "src/shiharai/handoff.cljc"
  :find "      (not= (count converted) (count results))"
  :replace "      (and false (count results))"}

 {:id :handoff-refusal-is-itself-a-fact
  :invariant "a refused batch still yields one fact to append"
  :file "src/shiharai/handoff.cljc"
