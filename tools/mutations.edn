 {:id :eu-refusal-names-the-japanese-register
  :invariant "a non-JP registration number is not called a 適格請求書 one"
  :file "src/shiharai/governor.cljc"
  :find "(str (if (= [:jp] jurisdiction)"
  :replace "(str (if (or true (= [:jp] jurisdiction))"}

 ;; RETARGETED 2026-08-18 after it SURVIVED, and the reason is recorded here
 ;; rather than the mutation being deleted. Its first form replaced
 ;; `:retention/years years` with `(or years 7)` inside the :stated branch —
 ;; where the preceding `(nil? years)` cond clause has already caught every
 ;; nil, so `years` is non-nil by construction and the `or` was a SEMANTIC
 ;; NO-OP. It survived because there was nothing to notice, which is a fact
 ;; about the mutation and not about the suite.
 ;;
 ;; The invention it is named for is reachable one branch up: put a year count
 ;; into the :deferred map, where the EU and the United States land and where
 ;; no instrument states one. That is the actual failure — a caller reading
 ;; "7" for a Directive that says each Member State shall determine the
 ;; period.
 {:id :retention-invents-seven-years
  :invariant "no year count where the instrument states none"
  :file "src/shiharai/jurisdiction.cljc"
  :find "       :retention/provision (:rule/provision facet)\n       :retention/quote (:rule/quote facet)"
  :replace "       :retention/years 7\n       :retention/provision (:rule/provision facet)\n       :retention/quote (:rule/quote facet)"}

 {:id :retention-deferred-becomes-stated
  :invariant "an instrument that states no number is not a :stated one"
  :file "src/shiharai/jurisdiction.cljc"
  :find "      (nil? years)\n      {:retention/coverage :deferred"
  :replace "      (and (nil? years) false)\n      {:retention/coverage :deferred"}

 {:id :retention-deferred-collapses-into-none
  :invariant "read-and-deferred is not the same answer as never-read"
  :file "src/shiharai/jurisdiction.cljc"
  :find "      {:retention/coverage :deferred\n       :retention/jurisdiction j"
  :replace "      {:retention/coverage :none\n       :retention/jurisdiction j"}

 {:id :retention-hides-who-sets-the-period
  :invariant "a deferred period names who does set it"
  :file "src/shiharai/jurisdiction.cljc"
  :find "       :retention/period-set-by (:rule/period-set-by facet)"
  :replace "       :retention/period-set-by nil"}

 {:id :retention-uncatalogued-becomes-deferred
  :invariant "a jurisdiction nobody read is :none, not :deferred"
  :file "src/shiharai/jurisdiction.cljc"
  :find "      (cond-> {:retention/coverage :none"
  :replace "      (cond-> {:retention/coverage :deferred"}

 {:id :retention-drops-what-japans-number-depends-on
  :invariant "7 years binds 青色申告法人 and the verdict says so"
  :file "src/shiharai/jurisdiction.cljc"
  :find "         (:rule/binds facet) (conj (:rule/binds facet))"
  :replace "         false (conj (:rule/binds facet))"}

 {:id :every-payable-gets-japans-retention
  :invariant "retention is read for the payable's own jurisdiction"
  :file "src/shiharai/governor.cljc"
  :find "     :retention (juris/retention jurisdiction)"
  :replace "     :retention (juris/retention [:jp])"}

 {:id :retention-does-not-reach-the-verdict
  :invariant "the verdict reports how long the invoice must be kept"
  :file "src/shiharai/governor.cljc"
  :find "              :retention (:retention a)"
  :replace "              :retention nil"}

 {:id :retention-does-not-reach-the-surface
  :invariant "the endpoint reports retention too"
  :file "src/shiharai/edge/endpoints.cljc"
  :find "   :retention (:retention verdict)"
  :replace "   :retention nil"}

