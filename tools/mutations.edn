  :replace ":handoff/facts []"}

 {:id :handoff-misattribution-refused
  :invariant "a result citing another document is not attributed here"
  :file "src/shiharai/handoff.cljc"
  :find "(and (some? echoed) (not= echoed payable))"
  :replace "(and false (not= echoed payable))"}

 {:id :handoff-batch-status-and-outcome-must-agree
  :invariant "a batch result's status and the ledger's own label must agree"
  :file "src/shiharai/handoff.cljc"
  :find "(if (and permitted (contains? permitted outcome))"
  :replace "(if (or permitted (contains? permitted outcome))"}

 {:id :handoff-missing-results-is-not-an-empty-batch
  :invariant "a reply with no :results is unreadable, not zero entries"
  :file "src/shiharai/handoff.cljc"
  :find "(not (sequential? results))"
  :replace "(and false results)"}

 {:id :handoff-reaches-nothing
  :invariant "recording an outcome produces a value and makes no call"
  :file "src/shiharai/handoff.cljc"
  :find "  (:require [clojure.string :as str]))"
  :replace "  (:require [clojure.java.io]\n            [clojure.string :as str]))"}

 ;; --- non-JP jurisdictions (taxlaw d2663b5, per-facet coverage) ------------
 ;; Written from the SOURCE, one per decision point, before the tests for them
 ;; were consulted. Two of these are the ones that matter: :us-hold-is-dropped
 ;; makes a United States payable payable, and :eu-partial-format-passes
 ;; schedules a payment on the string "XX1".

 {:id :us-hold-is-dropped
  :invariant "a payable whose credit facet the catalog deliberately omits is HELD"
  :file "src/shiharai/governor.cljc"
  :find "(and (= :none (:taxlaw/coverage tax)) (some? (:taxlaw/out-of-scope tax)))"
  :replace "(and (= :none (:taxlaw/coverage tax)) false)"}

 {:id :out-of-scope-collapses-into-uncatalogued
  :invariant "an omitted facet and an unread jurisdiction get different names"
  :file "src/shiharai/governor.cljc"
