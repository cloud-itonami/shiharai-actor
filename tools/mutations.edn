  :replace "(or true (nil? (:taxlaw/out-of-scope tax))))\n       (conj {:rule :unchecked-credit-jurisdiction"}

 {:id :out-of-scope-refusal-loses-its-reason
  :invariant "the US refusal carries WHY, not just a rule name"
  :file "src/shiharai/governor.cljc"
  :find "\" は kotoba.taxlaw が意図的に読んでいない: \"\n                           (:taxlaw/why tax)"
  :replace "\" は kotoba.taxlaw が意図的に読んでいない\"\n                           \"\""}

 {:id :eu-partial-format-passes
  :invariant "a credit accepted on a self-declared partial format check escalates"
